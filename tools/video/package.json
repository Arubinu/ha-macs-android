    "render:fr": "remotion render src/index.ts Main out/ha-macs-fr.mp4 --props=\"{\\\"lang\\\":\\\"fr\\\"}\"",
    "render:vertical:en": "remotion render src/index.ts Vertical out/ha-macs-vertical-en.mp4 --props=\"{\\\"lang\\\":\\\"en\\\"}\"",
    "render:vertical:fr": "remotion render src/index.ts Vertical out/ha-macs-vertical-fr.mp4 --props=\"{\\\"lang\\\":\\\"fr\\\"}\""
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
